# Path to the career-engine folder inside the Obsidian vault.
# Relative paths resolve against the repo root (process.cwd()).
VAULT_PATH="./reference-vault/career-engine"
# Mac: VAULT_PATH="/Users/michaelhoefert/Obsidian/Second Brain/career-engine"

# TypeSafe System One ("Jev") API key. Leave empty to use the deterministic
# mock evaluator — results are labelled mode: "mock".
TYPESAFE_API_KEY=

JEV_MODEL=jev-latest

# Deterministic keyword pre-rank keeps the top N candidates before Jev runs.
# Set to "all" to evaluate the entire corpus.
JEV_SHORTLIST=30

# Max parallel Jev evaluations.
JEV_CONCURRENCY=16

# Python interpreter for the vault's tools/export_docx.py (needs python-docx).
PYTHON_BIN=python3
